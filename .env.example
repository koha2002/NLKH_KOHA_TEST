# URL công khai của đúng môi trường đang chạy. Không ghi cứng domain trong code.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Khóa master chỉ ở Render: mã hóa API key do Admin nhập trước khi lưu vào Supabase.
# Tạo một chuỗi ngẫu nhiên dài (ít nhất 24 ký tự); không được đổi sau khi đã lưu API key.
INTEGRATION_SECRETS_KEY=

# Cloudflare R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nlkh-media
R2_PUBLIC_BASE_URL=

# Chuỗi bí mật tự tạo, dùng cho lịch GitHub Actions gọi schedule-runner.
SCHEDULER_SECRET=

# Email chủ sở hữu đầu tiên
OWNER_EMAIL=khanhhoa2002.hh@gmail.com
