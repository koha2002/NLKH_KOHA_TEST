-- V4.8: favicon metadata + folder-level Data/R2 permissions
alter table public.site_settings add column if not exists favicon_size integer not null default 32;
do $$ begin if not exists(select 1 from pg_constraint where conname='site_settings_favicon_size_check') then alter table public.site_settings add constraint site_settings_favicon_size_check check(favicon_size between 16 and 128); end if; end $$;
alter table public.data_collections add column if not exists r2_prefix text;
update public.data_collections set r2_prefix='data/'||slug where coalesce(r2_prefix,'')='';
create table if not exists public.user_collection_access(
 id uuid primary key default gen_random_uuid(),user_id uuid not null references public.profiles(id) on delete cascade,collection_id uuid not null references public.data_collections(id) on delete cascade,permission_level text not null default 'read' check(permission_level in('read','add','full')),granted_by uuid references public.profiles(id) on delete set null,expires_at timestamptz,created_at timestamptz not null default now(),updated_at timestamptz not null default now(),unique(user_id,collection_id)
);
alter table public.user_collection_access enable row level security;
drop policy if exists collection_access_self_read on public.user_collection_access;create policy collection_access_self_read on public.user_collection_access for select to authenticated using(user_id=auth.uid() or public.has_permission('data.manage'));
drop policy if exists collection_access_manage on public.user_collection_access;create policy collection_access_manage on public.user_collection_access for all to authenticated using(public.has_permission('data.manage')) with check(public.has_permission('data.manage'));
drop trigger if exists set_user_collection_access_updated_at on public.user_collection_access;create trigger set_user_collection_access_updated_at before update on public.user_collection_access for each row execute procedure public.set_updated_at();
-- carry legacy item permissions to the whole collection, strongest level wins
insert into public.user_collection_access(user_id,collection_id,permission_level,granted_by,expires_at)
select uda.user_id,di.collection_id,case max(case uda.permission_level when 'full' then 3 when 'add' then 2 else 1 end) when 3 then 'full' when 2 then 'add' else 'read' end,max(uda.granted_by),max(uda.expires_at)
from public.user_data_access uda join public.data_items di on di.id=uda.item_id where di.collection_id is not null group by uda.user_id,di.collection_id
on conflict(user_id,collection_id) do update set permission_level=excluded.permission_level,granted_by=excluded.granted_by,expires_at=excluded.expires_at;
create or replace function public.get_my_collection_permissions() returns table(collection_id uuid,permission_level text,expires_at timestamptz) language sql stable security definer set search_path=public as $$ select uca.collection_id,uca.permission_level,uca.expires_at from public.user_collection_access uca where uca.user_id=auth.uid() and(uca.expires_at is null or uca.expires_at>now()); $$;
revoke all on function public.get_my_collection_permissions() from public;grant execute on function public.get_my_collection_permissions() to authenticated;
-- collection visibility includes direct folder grants
drop policy if exists data_collections_read on public.data_collections;create policy data_collections_read on public.data_collections for select using((visible and visibility='public') or(visible and visibility='authenticated' and auth.uid() is not null) or exists(select 1 from public.user_collection_access u where u.collection_id=data_collections.id and u.user_id=auth.uid() and(u.expires_at is null or u.expires_at>now())) or public.has_permission('data.manage'));
-- item read inherits collection grants; legacy per-item grants remain compatible
drop policy if exists data_items_read on public.data_items;create policy data_items_read on public.data_items for select using((visible and visibility='public') or(visible and visibility='authenticated' and auth.uid() is not null) or exists(select 1 from public.user_collection_access u where u.collection_id=data_items.collection_id and u.user_id=auth.uid() and(u.expires_at is null or u.expires_at>now())) or exists(select 1 from public.user_data_access u where u.item_id=data_items.id and u.user_id=auth.uid() and(u.expires_at is null or u.expires_at>now())) or public.has_permission('data.manage'));
drop policy if exists data_items_admin_insert on public.data_items;create policy data_items_admin_insert on public.data_items for insert to authenticated with check(public.has_permission('data.manage') or exists(select 1 from public.user_collection_access u where u.collection_id=data_items.collection_id and u.user_id=auth.uid() and u.permission_level in('add','full') and(u.expires_at is null or u.expires_at>now())));
drop policy if exists data_items_update on public.data_items;create policy data_items_update on public.data_items for update to authenticated using(public.has_permission('data.manage') or exists(select 1 from public.user_collection_access u where u.collection_id=data_items.collection_id and u.user_id=auth.uid() and u.permission_level='full' and(u.expires_at is null or u.expires_at>now()))) with check(public.has_permission('data.manage') or exists(select 1 from public.user_collection_access u where u.collection_id=data_items.collection_id and u.user_id=auth.uid() and u.permission_level='full' and(u.expires_at is null or u.expires_at>now())));
drop policy if exists data_items_delete on public.data_items;create policy data_items_delete on public.data_items for delete to authenticated using(public.has_permission('data.manage') or exists(select 1 from public.user_collection_access u where u.collection_id=data_items.collection_id and u.user_id=auth.uid() and u.permission_level='full' and(u.expires_at is null or u.expires_at>now())));
-- media access also inherits folder grants
drop policy if exists media_public_read on public.media_assets;create policy media_public_read on public.media_assets for select using(visibility='public' or(visibility='authenticated' and auth.uid() is not null) or owner_id=auth.uid() or exists(select 1 from public.data_items di join public.user_collection_access u on u.collection_id=di.collection_id where di.media_id=media_assets.id and u.user_id=auth.uid() and(u.expires_at is null or u.expires_at>now())) or exists(select 1 from public.data_items di join public.user_data_access u on u.item_id=di.id where di.media_id=media_assets.id and u.user_id=auth.uid() and(u.expires_at is null or u.expires_at>now())) or public.has_permission('media.manage') or public.has_permission('data.manage'));
drop trigger if exists trg_grant_creator_access_to_new_data_item on public.data_items;
