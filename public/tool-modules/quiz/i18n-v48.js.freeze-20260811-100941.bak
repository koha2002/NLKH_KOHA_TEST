(function(){'use strict';const D=new Map(Object.entries({"Chào mừng đến với ôn thi cùng Quiz":"Welcome to Quiz practice","Chọn một quiz để bắt đầu hoặc tạo quiz của riêng bạn.":"Choose a quiz to start or create your own.","Danh sách Quiz có sẵn":"Available quizzes","Nhập Quiz từ file":"Import Quiz from file","Chuyển đổi file từ Word":"Convert from Word","Tạo Quiz Mới":"Create New Quiz","Sẵn sàng chơi!":"Ready to play!","Nhập tên và chọn chế độ chơi.":"Enter your name and choose a game mode.","Nhập tên của bạn...":"Enter your name...","Chế độ chơi":"Game mode","Kiểm tra":"Test","Luyện tập":"Practice","Tùy chọn":"Options","Bắt đầu":"Start","Quay lại":"Back","Câu hỏi":"Questions","Đáp án":"Answers","Tiếp theo":"Next","Trước":"Previous","Nộp bài":"Submit","Kết quả":"Results","Làm lại":"Try again","Về trang chủ":"Back to home","Tạo câu hỏi":"Create question","Tiêu đề bộ câu hỏi":"Quiz title","Tải file .docx":"Upload .docx file","Xóa file đã chọn":"Clear selected file","Hoặc dán nội dung thô":"Or paste raw content","Xóa nội dung nhập tay":"Clear pasted content","Màu mẫu nhận diện đáp án đúng":"Reference color for correct answers","Hoặc chọn màu tùy chỉnh":"Or choose a custom color","Chuyển đổi":"Convert","Nhập vào danh sách quiz":"Import into quiz list","Đưa vào màn tạo quiz":"Load into quiz creator","Kết quả JSON":"JSON result","Sẵn sàng.":"Ready.","Chưa có dữ liệu.":"No data yet.","Xuất PDF":"Export PDF","Xuất Word (.docx)":"Export Word (.docx)","Xuất JSON":"Export JSON","Hủy":"Cancel","Xuất câu hỏi và đáp án":"Export questions and answers","Chỉ có câu hỏi và đáp án đúng. Dùng làm tài liệu ôn tập nhanh.":"Questions and correct answers only, for quick review.","Xuất ngẫu nhiên":"Random export","Chọn ngẫu nhiên một số câu hỏi từ bộ đề.":"Choose a random subset of questions.","câu hỏi":"questions"}));const original=new WeakMap(),attrs=new WeakMap();function tr(s){const z=s.trim();if(D.has(z))return s.replace(z,D.get(z));return s.replace(/^Câu (\d+)/,'Question $1').replace(/(\d+) câu hỏi/g,'$1 questions').replace(/^Lỗi khi đọc file\. Vui lòng kiểm tra lại file JSON\.$/,'Could not read the file. Check the JSON file.').replace(/^Đã cập nhật quiz thành công!$/,'Quiz updated successfully!')}function walk(n,en){if(n.nodeType===3){if(!original.has(n))original.set(n,n.nodeValue);n.nodeValue=en?tr(original.get(n)):original.get(n);return}if(n.nodeType!==1)return;const e=n;if(!attrs.has(e)){const o={};['placeholder','title','aria-label'].forEach(a=>{if(e.hasAttribute(a))o[a]=e.getAttribute(a)});attrs.set(e,o)}Object.entries(attrs.get(e)).forEach(([a,v])=>e.setAttribute(a,en?tr(v):v));[...e.childNodes].forEach(x=>walk(x,en))}let busy=false;function apply(){if(busy)return;busy=true;walk(document.body,document.documentElement.lang==='en');busy=false}const oldAlert=window.alert;window.alert=function(m){return oldAlert(document.documentElement.lang==='en'?tr(String(m)):m)};const oldConfirm=window.confirm;window.confirm=function(m){return oldConfirm(document.documentElement.lang==='en'?tr(String(m)):m)};new MutationObserver(()=>queueMicrotask(apply)).observe(document.documentElement,{attributes:true,attributeFilter:['lang'],childList:true,subtree:true,characterData:true});window.addEventListener('load',apply);apply()})();
