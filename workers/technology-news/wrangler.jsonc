{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nlkh-technology-news",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": false,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "automation.nguyenlekhanhhoa.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 23 * * *"]
  }
}
